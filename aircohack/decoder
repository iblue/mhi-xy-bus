#!/usr/bin/env ruby
require "byebug"
unless ARGV[0]
  puts "Usage: decoder <file>"
  exit 1
end

# Levels
HIGH = 4.4 # volts
LOW =  3.2 # volts

# Signal has to be this duration to be registered
DURATION = 40e-6 # seconds (40 us)
SILENCE = 20e-3  # seconds (20 ms)

edges = []

puts "### Pass 1 - Detecting flanks + packets ###"
begin
  lastlevel = :tristate
  silence_since = 0.0
  silence = false

  File.open(ARGV[0]) do |f|
    f.each_line do |line|
      next if line[0] == " " # Skip header
      time,voltage = line.split(", ").map(&:to_f)
      #puts "#{time}:#{voltage}"

      level = :tristate
      if voltage > HIGH
        level = :high
      elsif voltage < LOW
        level = :low
      end

      if level != lastlevel
        puts "Edge deteced: #{lastlevel} -> #{level} @ #{time}"
        edges << [lastlevel, level, time]

        if level == :tristate
          silence_since = time
        end
      end

      if !silence && level == :tristate && time-silence_since > SILENCE
        puts "Silence detected @ #{time}"
        edges << [:silence, :silence, time]
        silence = true
      end

      if level != :tristate
        silence = false
      end

      lastlevel = level
    end
  end
rescue Errno::ENOENT => e
  puts "decoder: #{ARGV[0]}: No such file or directory"
  exit 1
end

puts "\n### Pass 2 - Detecting needles ###"
# detect flanks
flank = nil
starts = nil
ends  = nil
flanks = []
edges.each do |from, to, time|
  if from == :tristate && flank == nil
    starts = time
    flank = to
  end

  if from == flank && to == :tristate
    ends = time
  end

  if from == :silence
    puts "Detected packet end"
    flanks << [:end, time]
  end

  if starts && ends && flank
    if ends-starts >= DURATION
      puts "Detected flank #{flank} @ #{time}, duration: #{ends-starts}."
      flanks << [flank, ends]
    end

    starts = nil
    ends = nil
    flank = nil
  end
end

