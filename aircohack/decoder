puts "\n### Pass 3 - Parsing signal"
def parse_time(timediff)
  us = (timediff*1_000_000).to_i
  puts "Timediff #{us} us"
  result = if us > 90 && us < 120
    0
  elsif us > 180 && us < 220
    1
  elsif us > 280 && us < 340
    2
  elsif us > 390 && us < 440
    3
  elsif us > 500 && us < 540
    4
  elsif us > 600 && us < 650
    5
  elsif us > 700 && us < 750
    6
  elsif us > 800 && us < 850
    7
  else
    raise "Timing not detected: #{us} us"
  end

  puts "Decoded as 0b#{result.to_s(2)}"
  result
end
lastflank = nil
lasttime  = nil
signals = []
packets = []
flanks.each do |flank, time|
  if lastflank == :low && flank == :high
    diff = time - lasttime
    signals << parse_time(diff)
  end

  if flank == :end
    puts "--- Packet end @ #{time}"
    packets << [time, signals]
    signals = []
  end

  lastflank = flank
  lasttime  = time
end

