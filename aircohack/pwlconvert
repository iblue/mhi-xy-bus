#!/usr/bin/env ruby
require "byebug"
unless ARGV[0] && ARGV[1]
  puts "Usage: pwlconvert <in> <out> - Converts saleae file to LTspice pwl"
  exit 1
end

MULTIPLICATOR = 16.95/3.87

begin
  starttime = nil
  File.open(ARGV[0]) do |infile|
    File.open(ARGV[1], "w") do |out|
      infile.each_line do |line|
        next if line[0] == " " # Skip header
        time,voltage = line.split(", ").map(&:to_f)
        starttime ||= time

        out << "#{time-starttime} #{voltage*MULTIPLICATOR}\n"
      end
    end
  end
rescue Errno::ENOENT => e
  puts "pwlconvert: #{ARGV[0]} or #{ARGV[1]}: No such file or directory"
  exit 1
end
